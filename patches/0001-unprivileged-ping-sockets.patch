                 }
 
-                sock = socket(IPAddress::GetFamily(type), SOCK_RAW, protocol);
+                sock = socket(IPAddress::GetFamily(type), SOCK_DGRAM, protocol);
 #ifdef _WIN32
                 if (sock == INVALID_SOCKET) {
 #else
